  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Debug Tests",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "env": {},
      "sourceMaps": true,
      "pauseForSourceMap": true,
      // "resolveSourceMapLocations": [
      //   "${workspaceFolder}/**",
      //   "!**/node_modules/**"
      // ],
      "sourceMapPathOverrides": {
        "/workspaces/forks/reactive-compute-benchmark/*": "${workspaceFolder}/*"
      },
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "test-debug", "-f", "r3-lazy", "-t", "cellx (2)"],
      "attachSimplePort": 9229
    },
    {
      "request": "launch",
      "name": "Debug Benchmarks",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "env": {},
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "bench-debug",
        "-f",
        "metron-z",
        "-b",
        "to many (100x",
        "-m"
      ],
      "attachSimplePort": 9229
    }
  ]
}

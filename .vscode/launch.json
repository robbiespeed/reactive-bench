  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Debug Tests",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "env": {},
      "sourceMaps": true,
      "pauseForSourceMap": true,
      // "resolveSourceMapLocations": [
      //   "${workspaceFolder}/**",
      //   "!**/node_modules/**"
      // ],
      "sourceMapPathOverrides": {
        "/workspaces/forks/reactive-compute-benchmark/*": "${workspaceFolder}/*"
      },
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "test-debug", "-f", "metron-v1"],
      "attachSimplePort": 9229
    },
    {
      "request": "launch",
      "name": "Debug Fallback",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "env": {},
      "sourceMaps": true,
      "pauseForSourceMap": true,
      // "resolveSourceMapLocations": [
      //   "${workspaceFolder}/**",
      //   "!**/node_modules/**"
      // ],
      "sourceMapPathOverrides": {
        "/workspaces/forks/reactive-compute-benchmark/*": "${workspaceFolder}/*"
      },
      "runtimeExecutable": "deno",
      "runtimeArgs": ["run", "--inspect-brk", "--sloppy-imports", "./packages/start/src/frameworks/metron-1/fallback-test.ts"],
      "attachSimplePort": 9229
    },
    {
      "request": "launch",
      "name": "Debug Benchmarks",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "env": {},
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "bench-debug",
        "-f",
        "projection (def",
        "-b",
        "cellx (write row by row read all 10x50)",
        "-m"
      ],
      "attachSimplePort": 9229
    }
  ]
}

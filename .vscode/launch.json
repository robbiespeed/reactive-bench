  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Debug Tests",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "env": {},
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "test-debug", "-f", "metron-z"],
      "attachSimplePort": 9229
    },
    {
      "request": "launch",
      "name": "Debug Benchmarks",
      "type": "node",
      "cwd": "${workspaceFolder}",
      "env": {},
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "bench-debug",
        "-f",
        "metron-z",
        "-b",
        "to many (100x",
        "-m"
      ],
      "attachSimplePort": 9229
    }
  ]
}
